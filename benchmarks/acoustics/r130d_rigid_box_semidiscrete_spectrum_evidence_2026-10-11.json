          40,
          32
        ]
      }
    },
    "operator": "seven-point second-difference Neumann Laplacian, cell-centered pressure, ghost-node Neumann convention identical to the canonical PFFDTD stencil",
    "eigensolver": "scipy.sparse.linalg.eigsh(k lowest, sigma=-1, which='LM', tol<=1e-9); full basis for h=0.1",
    "comparisons": [
      {
        "name": "discrete_operator_exactness",
        "reference": "closed-form discrete Neumann eigenvalues lambda = (2/h)^2 * sum_i sin^2(pi*n_i/(2*N_i))",
        "tolerance_relative": 1e-08
      },
      {
        "name": "continuum_mode_agreement",
        "reference": "analytic rigid-box modes f = (c/2)*sqrt(sum_i (n_i/L_i)^2)",
        "metric": "relative frequency error per analytic mode vs nearest discrete mode; every analytic mode below the cutoff must be matched",
        "tolerance_relative": 0.02
      },
      {
        "name": "dispersion_bound",
        "reference": "seven-point leading dispersion: relative error <= (pi*f*h/c)^2/12 times declared safety factor 2.0",
        "per_mode": true
      },
      {
        "name": "unresolved_cluster_coverage",
        "reference": "the 12 analytic clusters unresolved under record-peak detection in evidence r130d_reproduction_isolation_diagnostic_evidence.json; every unresolved analytic mode must be present in the discrete spectrum",
        "coverage_required": 1.0
      }
    ],
    "verdict_vocabulary": [
      "PHYSICS_VALIDATED_SEMIDISCRETE_SPECTRUM",
