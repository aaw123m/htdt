{
  "schema_version": "htdt.r130d.original-impulse-12-neumann-mode-projection-plan-1",
  "date": "2026-10-09",
  "issue": 938,
  "purpose": "Quantify how well only the first 12 independently validated spatial Neumann modes reproduce the original unsmoothed unit-impulse 40/80Hz finite-time transfer, then compare low-modal spatial convergence versus the real full-space FV/P2 time-integrated nonconvergence.",
  "immutable_inputs": [
    "benchmarks/acoustics/r130d_sloped_neumann_modal_spectrum_evidence_2026-10-09.json",
    "benchmarks/acoustics/r130d_exact_discrete_impulse_candidate_evidence_2026-10-09.json"
  ],
  "methods": [
    {
      "method": "embedded_neumann_FV",
      "levels": [
        12,
        20,
        32
      ]
    },
    {
      "method": "independent_pinned_MFEM_P2",
      "levels": [
        2,
        3,
        4
      ]
    }
  ],
  "source": {
    "q": "q[0]=1m3/s, q[n>0]=0",
    "dt_s": 0.00025,
    "steps": 1000,
    "duration_s": 0.25,
    "source_xyz_m": [
      1.5,
      2,
      2
    ],
    "receiver_xyz_m": [
      2.5,
      2,
      2
    ],
    "frequencies_hz": [
      40,
      80
    ],
    "rho_kg_m3": 1.2,
    "c_m_s": 343.2,
    "Fourier": "P_T/Q_T with exp(+iωt) at midpoint",
    "actual_implicit_midpoint_scalar_modal_ode": "u_j''+lambda_j*u_j=c^2*(b^T x_j)*q(t); pressure=rho*sum (r^T x_j)*u_j'",
    "same_source_as_frozen_fullspace": true
  },
  "spatial_modes": {
    "count_including_zero": 12,
    "nonzero": 11,
    "mass_normalization": "x.T*M*x=1",
    "mode_to_receiver_source_product": "(b.T*x_j)*(r.T*x_j)",
    "reconstruct_signed_modal_sum": true,
    "include_unregularized_zero_mode": true
  },
  "analysis": {
    "metrics": [
      "each fullwave vs 12mode truncated response normalized complex L2",
      "per-frequency complex/magnitude/phase differences",
      "modal12 adjacent-grid spatial difference",
      "original full-space adjacent-grid difference"
    ],
    "explicit_no_single_cause_claim": true,
    "zero_source_spectrum_missing_must_fail": true
  },
  "limits": {
    "max_modes": 12,
    "max_steps": 1000,
    "max_level_cases": 6
  },
  "gate": {
    "original_fullband_impulse": "SELF_CONVERGENCE_FAILED",
    "candidate_unfiltered_impulse": "NOT_QUALIFIED",
    "generic_CAD": "NOT_VALIDATED",
    "physical_data": "NOT_VALIDATED",
    "production_ready": false,
    "modal_diagnostic_only": true
  }
}
