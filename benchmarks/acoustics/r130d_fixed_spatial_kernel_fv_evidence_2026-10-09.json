    "date": "2026-10-09",
    "issue": 938,
    "pr": 1055,
    "purpose": "Isolate fixed-physical-width source and receiver operator sensitivity from original point-like source/receiver, while keeping the original q[0]=1 temporal impulse. This is a changed spatial model and NEVER original-impulse qualification.",
    "geometry": {
      "kind": "original 56 m3 exactly planar sloped room",
      "domain": "0<=x<=4, 0<=y<=4, 0<=z<=4-0.25*y",
      "volume_m3": 56,
      "source_xyz_m": [
        1.5,
        2,
        2
      ],
      "receiver_xyz_m": [
        2.5,
        2,
        2
      ],
      "sound_speed_m_s": 343.2,
      "density_kg_m3": 1.2,
      "boundary": "natural rigid Neumann"
    },
    "spatial_kernel": {
      "kind": "positive isotropic Gaussian exp(-|x-x0|^2/(2*sigma^2)) over physical air domain",
      "width_parameter": "sigma_m",
      "sigma_m": [
        0.35,
        0.7
      ],
      "source_and_receiver_identical_kernel_rule": true,
      "integral_over_domain_normalized_to_one_separately_at_each_grid": true,
      "retains_full_room_gaussian_tail": true,
      "source_force": "c^2 * volume_integral(N_i * normalized_gaussian_source) * q_mid",
      "receiver_pressure": "rho * sum(volume_integral(N_i * normalized_gaussian_receiver) * v_mid_i)",
      "fv_integration": "tensor Gauss-Legendre 4 points x,y,z, exact roof-clipped integration z upper=min(zcell_hi,4-0.25*y), piecewise split at roof crossing within y-cell",
      "mfem_integration": "MFEM H1 P2 DomainLFIntegrator GaussianCoefficient on independently triangulated sloped room; integration rule explicitly order 10; normalize by sum of P2 linear-form weights (partition of unity)",
      "point_model_control": "existing point-source/receiver exact-discrete q0 evidence, unchanged; no Gaussian temporal source"
    },
    "temporal_source": {
      "waveform": "q[0]=1, q[n>0]=0",
      "dt_s": 0.00025,
      "steps": 1000,
      "duration_s": 0.25,
      "frequency_bins_hz": [
        40,
        80
      ],
      "phase_convention": "P_T/Q_T with exp(+i*2*pi*f*t_mid), same time midpoint samples for both",
      "window": "un-tapered finite record",
      "frequency_mask": "none",
      "temporal_smoothing": false
    },
    "spatial_levels": {
      "fv_n": [
        12,
        20,
        32
      ],
