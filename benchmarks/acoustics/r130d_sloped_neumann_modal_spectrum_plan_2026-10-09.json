      "4": "e1c67d02db77a6e8775a0a59d8e75fa996434d58f8efae077f4cec2cf2c831ed"
    }
  },
  "metrics": [
    "first 11 nonzero natural mode frequencies by space and refinement",
    "smallest distance-to-target 40 and 80Hz mode",
    "normalized signed source and receiver mode shape product (phase arbitrary but product sign invariant)",
    "relative generalized mode residual",
    "max relative drift of ordered 11 modal frequencies between adjacent spatial refinements"
  ],
  "limits": {
    "max_dofs": 35937,
