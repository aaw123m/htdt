{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htdt.example/schemas/capture-bundle-v1/task-plan-status-1.0.0.schema.json",
  "title": "HTDT Capture Task Plan Status v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "capture_revision_id",
    "capture_session_id",
    "plan_id",
    "plan_version",
    "plan_sha256",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "htdt.capture-task-plan-status"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "capture_revision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capture_session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "outcome"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "pending",
              "completed",
              "skipped",
              "unavailable"
            ]
          }
        },
        "allOf": []
      }
    }
  }
}
